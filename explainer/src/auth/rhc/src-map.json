      "        self.requests",
      "            .lock()",
      "            .expect(\"requests\")",
      "            .push((url.to_string(), recorded));",
      "        let mut routes = self.routes.lock().expect(\"routes\");",
      "        for (key, queue) in routes.iter_mut() {",
      "            if url.contains(key) {",
      "                let (status, body) = queue",
      "                    .pop_front()",
      "                    .unwrap_or_else(|| panic!(\"no more responses for {key}\"));",
