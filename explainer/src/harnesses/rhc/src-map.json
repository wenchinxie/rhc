    "lines": [
      "fn find<'a>(subscriptions: Subscriptions<'a>, name: &str) -> Result<&'a dyn Auth, CliError> {",
      "    subscriptions",
      "        .iter()",
      "        .find(|(n, _)| *n == name)",
      "        .map(|(_, auth)| *auth)",
      "        .ok_or_else(|| CliError::UnknownSubscription {",
      "            name: name.to_string(),",
      "            choices: subscriptions",
      "                .iter()",
      "                .map(|(n, _)| *n)",
      "                .collect::<Vec<_>>()",
      "                .join(\", \"),",
      "        })",
      "}"
    ]
  },
