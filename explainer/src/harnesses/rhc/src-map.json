  "login": {
    "type": "code",
    "kind": "code",
    "title": "commands::login",
    "meta": "crates/rhc/src/bin/rhc/commands.rs:10-24",
    "why": "決定登入哪個訂閱：有名字就找，終端機就問，pipe 就報錯。",
    "start": 10,
    "hi": [
      12,
      13,
      15,
      22
